# Modelo local instalado en Ollama. No usar etiquetas cloud.
CHANGELAB_MODEL=qwen3:4b-instruct
# Opcional al ejecutar sin Docker (estos son los valores predeterminados):
# CHANGELAB_HOST=127.0.0.1
# PORT=4317
# CHANGELAB_OLLAMA_URL=http://127.0.0.1:11434
# Docker Compose usa 4320 en el equipo y host.docker.internal para Ollama.
# CHANGELAB_HTTP_PORT=4320

# Correos: por defecto se guardan para revisar y no salen del equipo.
CHANGELAB_MAIL_PROVIDER=preview
CHANGELAB_MAIL_ENABLE_SEND=false
# Para envío real: proveedor resend, remitente verificado, clave privada y URL HTTPS pública.
# CHANGELAB_MAIL_FROM=pedidos@tu-dominio.com
# CHANGELAB_MAIL_API_KEY=
# CHANGELAB_SHOP_URL=https://tu-tienda.com/mis-pedidos
# Ejecutar aparte npm run mail:worker. Los mensajes preview nunca se envían al activarlo.
